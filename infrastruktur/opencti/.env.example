# Contoh konfigurasi stack OpenCTI penelitian ini. SEMUA nilai rahasia diganti placeholder.
# Salin menjadi .env lalu isi nilai Anda sendiri. Jangan pernah commit file .env.
# Nilai non-rahasia di bawah sama dengan yang dipakai saat akuisisi data D1.

OPENCTI_VERSION=latest
OPENCTI_HOST=localhost
OPENCTI_PORT=8080
ELASTIC_MEMORY_SIZE=2g

OPENCTI_ADMIN_EMAIL=admin@example.org
OPENCTI_ADMIN_PASSWORD=ChangeMe
OPENCTI_ADMIN_TOKEN=ChangeMe-uuid-v4
OPENCTI_ENCRYPTION_KEY=ChangeMe
OPENCTI_HEALTHCHECK_ACCESS_KEY=ChangeMe

MINIO_ROOT_USER=ChangeMe
MINIO_ROOT_PASSWORD=ChangeMe
RABBITMQ_DEFAULT_USER=ChangeMe
RABBITMQ_DEFAULT_PASS=ChangeMe

# API key dari https://otx.alienvault.com/api
ALIENVAULT_API_KEY=ChangeMe
ALIENVAULT_CONNECTOR_ID=00000000-0000-4000-8000-000000000002
ALIENVAULT_DURATION_PERIOD=PT6H
ALIENVAULT_TLP=White
# Awal impor pulse; inilah sebabnya laporan D1 terbit mulai 2025.
ALIENVAULT_PULSE_START_TIMESTAMP=2025-01-01T00:00:00
CONNECTOR_LOG_LEVEL=info
IMPORT_FILE_STIX_CONNECTOR_ID=ChangeMe-uuid-v4

EXPORT_FILE_STIX_CONNECTOR_ID=00000000-0000-4000-8000-000000000003
CVE_NVD_CONNECTOR_ID=00000000-0000-4000-8000-000000000004
OPENCTI_DATASETS_CONNECTOR_ID=00000000-0000-4000-8000-000000000005
CISA_KEV_DURATION_PERIOD=P2D
OPENCTI_DATASETS_INTERVAL_DAYS=7
CVE_NVD_INTERVAL_HOURS=6
CVE_NVD_MAX_DATE_RANGE_DAYS=1
# API key NVD: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
