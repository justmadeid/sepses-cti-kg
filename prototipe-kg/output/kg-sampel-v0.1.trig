    ext:Report a owl:Class ;
        rdfs:label "Laporan CTI"@id ;
        rdfs:comment "CQ4-CQ6. Laporan STIX (report) dari OpenCTI. IRI laporan sekaligus menjadi nama graf yang memuat isi laporan tersebut."@id ;
        rdfs:subClassOf prov:Entity .

    cat:relationship a owl:Class ;
        rdfs:label "Relasi STIX sebagai resource"@id .

    ext:ExposureAssessment a owl:Class ;
        rdfs:label "Penilaian exposure"@id ;
        rdfs:comment "CQ1. Hasil pencocokan aset-CVE dengan status TRUE/FALSE/UNKNOWN (logika tiga nilai Kleene) dan dasar pencocokannya."@id ;
        rdfs:subClassOf prov:Entity .

    cve:CVE a owl:Class ;
        rdfs:label "CVE" ;
        rdfs:isDefinedBy <http://w3id.org/sepses/vocab/ref/cve> .
}

