# CQ2. Berapa CVSS dan CWE setiap CVE yang (mungkin) memengaruhi aset?
#      Sumber: graf cve-sepses (kosakata SEPSES; data dari CVE List v5).
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX dcterm: <http://purl.org/dc/terms/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX cve: <http://w3id.org/sepses/vocab/ref/cve#>
PREFIX cvss: <http://w3id.org/sepses/vocab/ref/cvss#>
PREFIX cat: <http://w3id.org/sepses/vocab/ref/attack#>
PREFIX ext: <http://example.org/jejak-vp/ext#>
PREFIX g: <http://example.org/jejak-vp/graph/>

SELECT ?cve (SAMPLE(?skor3) AS ?cvss3) (SAMPLE(?sev3) AS ?keparahan3) (SAMPLE(?skor4) AS ?cvss4)
       (GROUP_CONCAT(DISTINCT STRAFTER(STR(?cwe), "cwe/"); separator=", ") AS ?cwe_list)
WHERE {
  GRAPH g:derived-exposure { ?e ext:assessedCVE ?c ; ext:exposureStatus ?st . FILTER(?st != "FALSE") }
  GRAPH g:cve-sepses {
    ?c dcterm:identifier ?cve .
    OPTIONAL { ?c cve:hasCVSS3BaseMetric ?m . ?m cvss:baseScore ?skor3 ; cvss:baseSeverity ?sev3 . }
    OPTIONAL { ?c ext:cvssV4BaseScore ?skor4 . }
    OPTIONAL { ?c cve:hasCWE ?cwe . }
  }
}
GROUP BY ?cve
ORDER BY ?cve
